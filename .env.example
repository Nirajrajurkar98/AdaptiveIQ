# Copy to .env and change the development password before starting PostgreSQL.
POSTGRES_DB=adaptiveiq
POSTGRES_USER=adaptiveiq
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://adaptiveiq:change-this-local-password@localhost:5432/adaptiveiq?schema=public
API_PORT=3000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
AUTH_COOKIE_SECURE=false
ADMIN_BOOTSTRAP_SECRET=
